#!/usr/bin/python3
"""Root-owned FogBot deployment helper loader.

Install this file as ``/usr/local/libexec/fogbot-deploy`` and install the
reviewed ``deployment`` package next to it in
``/usr/local/libexec/fogbot-deploy-source``.  The loader accepts no shell
syntax and delegates the argv/SSH forced-command grammar to the package.
"""

from __future__ import annotations

from pathlib import Path
import sys


SOURCE_ROOT = Path("/usr/local/libexec/fogbot-deploy-source")
if not SOURCE_ROOT.is_dir():
    raise SystemExit(4)
sys.path.insert(0, str(SOURCE_ROOT))

from deployment.server.fogbot_deploy.runtime import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main())
