{
  "github": {
    "repository_owner": "example-owner",
    "repository_name": "example-repository",
    "repository_id": 1,
    "head_repository_id": 1,
    "workflow_id": 1,
    "workflow_path": ".github/workflows/ci.yml",
    "main_branch": "main",
    "minimum_activation_run_id": 1,
    "activation_timestamp": "2026-01-01T00:00:00+00:00",
    "max_run_age_seconds": 86400
  },
  "layout": {
    "releases": "/opt/fogbot/releases",
    "source_repository": "/opt/fogbot/source",
    "shared": "/opt/fogbot/shared",
    "state": "/var/lib/fogbot",
    "operations": "/var/lib/fogbot/operations",
    "backups": "/var/lib/fogbot/backups",
    "configuration": "/opt/fogbot/shared/configuration.json",
    "database": "/opt/fogbot/shared/db/bot.db",
    "readiness": "/var/lib/fogbot/runtime/ready.json",
    "instance_lock": "/var/lib/fogbot/runtime/instance.lock",
    "sha_marker": "/var/lib/fogbot/current.sha",
    "minimum_free_bytes": 536870912
  },
  "policy": {
    "stop_timeout_seconds": 180,
    "startup_timeout_seconds": 60,
    "health_timeout_seconds": 30,
    "health_poll_seconds": 2
  }
}
