# Fill each <...> value after approved, read-only server inspection. Do not install verbatim.
[Unit]
Description=FogBot service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<FOGBOT_USER>
Group=<FOGBOT_GROUP>
# Fail closed when the external Discord credentials file is absent; otherwise
# main.py could try to create a mutable .env inside the release directory.
EnvironmentFile=/etc/fogbot/fogbot.env
# Keep mutable production state outside the immutable release. Replace each
# placeholder with the paths verified during the server inspection.
Environment=FOGBOT_CONFIG_PATH=<FOGBOT_CONFIG_PATH>
Environment=FOGBOT_DB_PATH=<FOGBOT_DB_PATH>
Environment=FOGBOT_LOG_DIR=<FOGBOT_LOG_DIR>
Environment=FOGBOT_RUNTIME_DIR=<FOGBOT_RUNTIME_DIR>
Environment=FOGBOT_RELEASE_FILE=<FOGBOT_RELEASE_FILE>
Environment=FOGBOT_INSTANCE_LOCK=<FOGBOT_INSTANCE_LOCK>
WorkingDirectory=/opt/fogbot/current
ExecStart=/opt/fogbot/current/.venv/bin/python /opt/fogbot/current/main.py
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=180
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
